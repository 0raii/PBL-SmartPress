<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btnBackGuide"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_head" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="32dp"
            android:layout_toEndOf="@id/btnBackGuide"
            android:text="Panduan Pengguna"
            android:textColor="@color/text_head"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cara Menggunakan Aplikasi"
                android:textColor="@color/primary_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Beranda -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Kontrol Lampu &amp; Mode"
                android:textColor="@color/text_head"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Gunakan tombol ON/OFF untuk kontrol manual jarak jauh.\n● Mode OTOMATIS: Lampu akan menyala otomatis berdasarkan tingkat kegelapan yang dideteksi sensor.\n● Penjadwalan (Timer): Atur jam mulai dan selesai agar lampu bekerja sesuai jadwal tertentu."
                android:textColor="@color/text_sub"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="4dp"/>

            <!-- Monitoring Daya -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Monitoring Energi &amp; Biaya"
                android:textColor="@color/text_head"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Pantau Watt, Voltase, dan Arus secara real-time.\n● Lihat total penggunaan energi dalam kWh serta estimasi biaya listrik harian Anda."
                android:textColor="@color/text_sub"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="4dp"/>

            <!-- Laporan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Laporan &amp; Riwayat"
                android:textColor="@color/text_head"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Menu Aktivitas: Melihat riwayat interaksi sistem (Sistem, Manual, Otomatis).\n● Menu Laporan: Melihat grafik statistik harian/mingguan/bulanan dan mengunduh laporan dalam format PDF."
                android:textColor="@color/text_sub"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="4dp"/>

            <!-- Keamanan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Sistem Proteksi &amp; Notifikasi"
                android:textColor="@color/text_head"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Proteksi Tegangan/Arus: Sistem akan memberi peringatan jika terdeteksi kondisi listrik yang tidak stabil atau bahaya korsleting.\n● Notifikasi: Dapatkan pemberitahuan langsung di HP saat lampu menyala, saat ada peringatan energi, atau saat pemakaian melebihi durasi wajar."
                android:textColor="@color/text_sub"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="4dp"/>

            <!-- Pengaturan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Pengaturan Sensitivitas &amp; Tema"
                android:textColor="@color/text_head"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Atur ambang batas (threshold) sensor cahaya sesuai keinginan (Level 1-3).\n● Ganti tema aplikasi (Terang/Gelap) sesuai kenyamanan mata Anda."
                android:textColor="@color/text_sub"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginVertical="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catatan: Pastikan koneksi internet Anda stabil agar sinkronisasi data dengan perangkat berjalan lancar."
                android:textColor="@color/accent_yellow"
                android:textSize="14sp"
                android:textStyle="italic" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
